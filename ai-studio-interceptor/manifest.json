{
    "manifest_version": 3,
    "name": "AI Studio Safety & Prompt Vault",
    "version": "1.3.2",
    "description": "Intercepta y rescata respuestas de AI Studio agrupadas por prompt y chat, con almacenamiento persistente.",
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://aistudio.google.com/*",
        "https://alkalimakersuite-pa.clients6.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://aistudio.google.com/*"
            ],
            "js": [
                "interceptor.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://aistudio.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}