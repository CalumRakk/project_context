{
    "manifest_version": 3,
    "name": "AI Studio Safety & Stream Interceptor",
    "version": "1.0.4",
    "description": "Intercepta respuestas de AI Studio, rescata texto y almacena historial temporal en memoria.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://aistudio.google.com/*",
        "https://alkalimakersuite-pa.clients6.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://aistudio.google.com/*"
            ],
            "js": [
                "interceptor.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://aistudio.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "world": "ISOLATED",
            "run_at": "document_start"
        }
    ]
}